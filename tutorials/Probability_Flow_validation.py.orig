]

def condition_mask_for_model(model, x):
    """Build the per-model posterior mask used by ModelTransfuser.compare()."""
    x_dim = x.shape[-1]
    theta_dim = model.nodes_size - x_dim
    if theta_dim < 0:
        raise ValueError(f"Model nodes_size={model.nodes_size} is smaller than x_dim={x_dim}.")
    return torch.cat([torch.zeros(theta_dim), torch.ones(x_dim)])


